# =====================================================
# Application
# =====================================================

NODE_ENV=development
PORT=5000

# =====================================================
# Database
# =====================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerforge_db
TEST_DB_NAME=careerforge_test_db
DB_USER=root
DB_PASSWORD=your_database_password

# =====================================================
# Frontend / CORS
# =====================================================

CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# =====================================================
# Global Rate Limiting
# =====================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# Authentication Rate Limits
# =====================================================

LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

REGISTER_RATE_LIMIT_WINDOW_MINUTES=60
REGISTER_RATE_LIMIT_MAX_REQUESTS=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=60
FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=3

RESET_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=5

EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=5

EMAIL_CHANGE_REQUEST_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_CHANGE_REQUEST_RATE_LIMIT_MAX_REQUESTS=5

EMAIL_CHANGE_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=15
EMAIL_CHANGE_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10

REFRESH_TOKEN_RATE_LIMIT_WINDOW_MINUTES=15
REFRESH_TOKEN_RATE_LIMIT_MAX_REQUESTS=30

# =====================================================
# Sensitive Route Rate Limits
# =====================================================

REPORT_RATE_LIMIT_WINDOW_MINUTES=60
REPORT_RATE_LIMIT_MAX_REQUESTS=10

UPLOAD_RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20

# =====================================================
# JWT
# =====================================================

JWT_ACCESS_SECRET=replace_with_a_strong_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_strong_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# Cloudinary
# =====================================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLOUDINARY_PROFILE_IMAGE_FOLDER=careerforge/profile-images
CLOUDINARY_RESUME_FOLDER=careerforge/resumes
CLOUDINARY_COMPANY_LOGO_FOLDER=careerforge/company-logos

# =====================================================
# EMAIL / BREVO API
# =====================================================

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email