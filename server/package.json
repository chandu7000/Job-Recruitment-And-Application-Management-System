{
  "name": "careerforge-server",
  "version": "1.0.0",
  "description": "Production-ready backend API for the CareerForge professional job portal",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:prepare": "npm run db:migrate:test",
    "test:full": "npm run test:prepare && npm test",
    "lint": "eslint .",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:test": "sequelize-cli db:migrate --env test",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:test:undo": "sequelize-cli db:migrate:undo --env test",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "jobs:expire": "node src/scripts/closeExpiredJobs.js"
  },
  "keywords": [
    "careerforge",
    "job-portal",
    "nodejs",
    "express",
    "sequelize",
    "mysql"
  ],
  "author": "Chandra Sekhar Nadiminti",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}